node_modules/
whisper.cpp/
.remotion/
.sync-sheet.tmp.mjs
.stills.tmp.mjs

# Vendored Remotion agent-skill docs — 300+ third-party files. Regenerate with
# `npx remotion skills add`.
.agents/
.claude/

# Rendered video is far too large for git (a 18s 1080x1920 ProRes 4444 file is
# ~550 MB; the 4K one is ~2 GB). Everything needed to regenerate them
# byte-identically is committed — see out/README.md for the commands.
out/*.mov
out/*.mp4
out/qa/

# Working audio derived from assets-in/vo.mp3
public/vo.mp3
public/vo16.wav

# The vendored typeface is generated by scripts/vendor-fonts.mjs, but it is
# committed on purpose so a fresh clone renders offline without a fetch.
!public/fonts/
